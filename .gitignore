# Default deny: only source and reviewed assets are versioned.
/*
!/.gitignore
!/.gitattributes
!/*.py
!/*.ps1
!/*.md
!/requirements*.txt
!/market_index.html
!/market_ui.js
!/market_ui.css
!/market_selling.html
!/market_selling_ui.js
!/market_i18n.js
!/market_watchlist.js
!/test_market_watchlist.mjs
!/market_dashboard.html
!/item_catalog_template.html
!/maple_crypto_constants.cs
!/maple_aes.cs
!/COPYING.MapleLib
!/tools/
/tools/*
!/tools/market_bot_templates/
!/msnet_reference/
__pycache__/
*.pyc
.env*
*.pem
*.key
*.log
*.sqlite*
*.pcap*
*.etl

# Personal session analysis remains local.
/network_research.md

!/shared_login.html

!/market_screen_scanner/
!/market_screen_scanner/*.py
!/market_screen_scanner/*.ps1
!/market_screen_scanner/*.md
!/market_screen_scanner/*.txt
/market_screen_scanner/build_deps/
/market_screen_scanner/build/
/market_screen_scanner/dist/
/market_screen_scanner/build_*/
/market_screen_scanner/dist_*/
/market_screen_scanner/*.spec
/market_screen_scanner/__pycache__/
# One-off screenshots and release archives are local development output.
/market_screen_scanner/*.png
/market_screen_scanner/*.zip

# Market and catalogue snapshots remain local.
/data/
/test/
/.venv/
/vendor/
